# Pennytor frontend — production environment
#
# Create as frontend/.env.production BEFORE `npm run build`.
# NEXT_PUBLIC_* values are inlined into the bundle at build time; changing
# this file afterwards has no effect until you rebuild.
#
# Topology: frontend on pennytor.com, API on backend.pennytor.com.
NEXT_PUBLIC_API_URL="https://backend.pennytor.com/api"
NEXT_PUBLIC_SITE_URL="https://pennytor.com"
NEXT_PUBLIC_WHATSAPP_PHONE_NUMBER="7992255760"
NEXT_PUBLIC_WHATSAPP_MESSAGE="Hello! I want to know more"
NEXT_PUBLIC_CONTACT_MESSAGE_TIME=10
